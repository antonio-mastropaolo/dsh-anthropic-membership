{
  "name": "dsh-model-hub",
  "version": "3.0.0",
  "description": "Model hub for DeepSeek Harness: provider sign-in, per-model cost ledger and spend caps, prompt-cache checks, an optional GPU-server panel and the dsh-hub CLI.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "model-hub",
    "cost-tracking",
    "spend-caps",
    "budget",
    "llm-cost",
    "prompt-cache",
    "claude",
    "codex",
    "ollama",
    "cli"
  ],
  "license": "MIT",
  "author": "Antonio Mastropaolo",
  "homepage": "https://github.com/antonio-mastropaolo/dsh-model-hub#readme",
  "bugs": {
    "url": "https://github.com/antonio-mastropaolo/dsh-model-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonio-mastropaolo/dsh-model-hub.git"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.12",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./lib/index.js",
  "bin": {
    "dsh-hub": "./bin/dsh-hub.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/dsh-hub.mjs",
    "lib",
    "!lib/**/*.test.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node --test lib/*.test.mjs lib/accounts/*.test.mjs lib/cost/*.test.mjs lib/demo/*.test.mjs lib/host/*.test.mjs bin/*.test.mjs lib/client/*.test.mjs"
  }
}
